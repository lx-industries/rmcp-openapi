{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>lx-industries/renovate-config"
  ],
  "gitlabci": {
    "registryAliases": {
      "${CI_REGISTRY_IMAGE}": "registry.gitlab.com/lx-industries/rmcp-openapi"
    }
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "rmcp{/,}**"
      ],
      "groupName": "rmcp crates"
    },
    {
      "matchPackageNames": [
        "${ci_registry_image}/images/rust",
        "registry.gitlab.com/lx-industries/rmcp-openapi/images/rust"
      ],
      "groupName": "Rust images"
    },
    {
      "matchPackageNames": [
        "rust"
      ],
      "matchDatasources": [
        "docker"
      ],
      "schedule": [
        "on the first day of the month"
      ]
    },
    {
      "description": "Hold below v10 until @semantic-release/release-notes-generator ships conventional-changelog-writer@9 in a stable release. See https://gitlab.com/lx-industries/rmcp-actix-web/-/issues/62",
      "matchPackageNames": [
        "conventional-changelog-conventionalcommits"
      ],
      "matchDatasources": [
        "npm"
      ],
      "allowedVersions": "<10"
    },
    {
      "description": "Hold docker dind at 29.6.x: since 29.7 the containerd image store push to the GitLab registry fails with \"blob unknown to registry\". See https://github.com/moby/moby/issues/53293. Remove this rule once a Docker release fixing that issue is available.",
      "matchPackageNames": [
        "docker"
      ],
      "matchDatasources": [
        "docker"
      ],
      "allowedVersions": "/^29\\.6\\./"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( registryUrl=(?<registryUrl>\\S+))?( versioning=(?<versioning>\\S+))?( extractVersion=(?<extractVersion>\\S+))?\\s(ENV|ARG)\\s.*?_VERSION\\s*=?\"(?<currentValue>.*)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/).*\\.gitlab-ci\\.yml$/"
      ],
      "matchStrings": [
        "\\s*# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( registryUrl=(?<registryUrl>\\S+))?( versioning=(?<versioning>\\S+))?( extractVersion=(?<extractVersion>\\S+))?\\s*.+_VERSION\\s*:\\s*\"(?<currentValue>.*)\""
      ]
    }
  ]
}
